# --- Demo behaviour ---
DEMO_MODE=true                       # collapses dispute/term windows to seconds
# DISPUTE_WINDOW_MS=6000             # override release delay after attestation

# --- Database ---
# DATABASE_FILE=./data/pesashule.db  # local SQLite path (default)
# DATABASE_URL=postgres://...        # production: Neon Postgres

# --- Lightning ---
LIGHTNING_BACKEND=mock               # mock | lnd | voltage | polar
# For LIGHTNING_BACKEND=lnd, run `npm run ln:up && npm run ln:setup`, which
# generates .env.local with the values below (payee = TrailPay, payer = sender):
# LND_PAYEE_SOCKET=127.0.0.1:10009
# LND_PAYEE_CERT=base64...
# LND_PAYEE_MACAROON=base64...
# LND_PAYER_SOCKET=127.0.0.1:10010
# LND_PAYER_CERT=base64...
# LND_PAYER_MACAROON=base64...

# --- FX (demo uses fixed rates) ---
# FX_KES_PER_USD=145
# FX_BTC_USD=100000

# --- Crypto ---
PREIMAGE_ENCRYPTION_KEY=dev-only-insecure-key-change-me-in-production-0000

# --- Production integrations (not required for the demo) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BITNOB_API_KEY=sandbox_xxx
# BITNOB_WEBHOOK_SECRET=xxx
# RESEND_API_KEY=...
# NOSTR_PRIVATE_KEY=nsec1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
